#!/usr/bin/env bash
# Run the learning engine from this folder without activating the virtual environment.
# First run: finds Python 3.11 or newer and builds .venv. Later runs: rebuilds .venv only if it
# broke or the folder was moved. Set LEARN_PYTHON to choose the interpreter yourself.
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VENV="$DIR/.venv"
STAMP="$VENV/learn-root.txt"   # the folder this .venv was built for
DEPS="$VENV/learn-deps.toml"   # copy of the pyproject.toml its packages were installed from
export PYTHONUTF8=1            # read and print text as UTF-8 everywhere

supported() { "$@" -c 'import sys; sys.exit(sys.version_info < (3, 11))' >/dev/null 2>&1; }

# After a git pull, pyproject.toml may list new packages (hypothesis, httpx, ...): install them once.
# One try only, so an offline machine is not slowed down on every run; never during Tab completion.
sync_deps() {
  [ "$1" = "_complete" ] && return
  cmp -s "$DIR/pyproject.toml" "$DEPS" && return
  echo "The course lists new packages. Installing them (needs internet once)..."
  if ! PYYAML_FORCE_LIBYAML=0 "$VENV/bin/python" -m pip install -q --disable-pip-version-check -e "$DIR"; then
    echo "Could not install them. Later, with internet, run: .venv/bin/python -m pip install -e ." >&2
  fi
  cp "$DIR/pyproject.toml" "$DEPS"
}

# Fast path (Tab completion runs this on every key): .venv exists and was built for this folder.
if [ -x "$VENV/bin/python" ] && [ "$(cat "$STAMP" 2>/dev/null)" = "$DIR" ]; then
  sync_deps "$@"
  exec "$VENV/bin/python" -m learn "$@"
fi

# A .venv from before the stamp existed: keep it if it loads the engine from this folder.
OURS='import os, sys, learn; sys.exit(os.path.normcase(learn.__file__).find(os.path.normcase(sys.argv[1])) != 0)'
if [ -x "$VENV/bin/python" ] && "$VENV/bin/python" -c "$OURS" "$DIR/engine" >/dev/null 2>&1; then
  echo "$DIR" > "$STAMP"
  sync_deps "$@"
  exec "$VENV/bin/python" -m learn "$@"
fi

if [ -n "$LEARN_PYTHON" ]; then
  PY="$LEARN_PYTHON"
  if ! supported "$PY"; then
    echo "LEARN_PYTHON is set to '$PY', but that is not Python 3.11 or newer." >&2
    exit 1
  fi
else
  PY=""
  for cand in python3 python3.14 python3.13 python3.12 python3.11 python; do
    if command -v "$cand" >/dev/null 2>&1 && supported "$cand"; then PY="$cand"; break; fi
  done
  if [ -z "$PY" ]; then
    found="$(python3 --version 2>&1 || true)"
    echo "This course needs Python 3.11 or newer.${found:+ Found: $found.}" >&2
    echo "Install it (Ubuntu/Debian: sudo apt install python3; macOS: python.org or brew install python)," >&2
    echo "then run this command again. To use a specific one: LEARN_PYTHON=/path/to/python3 ./learn" >&2
    exit 1
  fi
fi

if [ -d "$VENV" ]; then
  echo "The engine's environment (.venv) is broken, incomplete or from another folder. Rebuilding it..."
  rm -rf "$VENV"
else
  echo "Setting up the engine for the first time (needs internet once)..."
fi

if ! "$PY" -m venv "$VENV"; then
  echo >&2
  echo "Could not create .venv with $PY." >&2
  echo "On Ubuntu/Debian install the venv module first: sudo apt install python3-venv" >&2
  rm -rf "$VENV"
  exit 1
fi

# PyYAML: skip its optional C extension so no compiler is ever needed (the engine uses the
# pure-Python loader anyway). This matters on brand-new Pythons that have no prebuilt wheel yet.
if ! PYYAML_FORCE_LIBYAML=0 "$VENV/bin/python" -m pip install -q --disable-pip-version-check -e "$DIR"; then
  echo >&2
  echo "Installing the engine's packages failed (see the message above)." >&2
  echo "Check your internet connection, then run this command again." >&2
  exit 1
fi

echo "$DIR" > "$STAMP"
cp "$DIR/pyproject.toml" "$DEPS"
exec "$VENV/bin/python" -m learn "$@"
